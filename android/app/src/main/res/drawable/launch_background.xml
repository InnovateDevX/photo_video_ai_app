<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen – shown immediately when the Android process starts.
     Uses solid black background and rounded launcher icon to match Flutter splash screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid black background -->
    <item>
        <color android:color="#000000" />
    </item>

    <!-- Centered rounded app logo at 96dp size -->
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher_round" />
</layer-list>